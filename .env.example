# ── Five Rupees Dreams — Contact Server Environment ──────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Port the server listens on (default: 3001)
PORT=3001

# Gmail address used to SEND emails (the account that owns the App Password)
SMTP_USER=your-sending-address@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
# Steps:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to: Google Account > Security > 2-Step Verification > App passwords
#   3. Create a new app password, select "Mail" + "Other (custom)"
#   4. Paste the 16-character password here (no spaces)
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Gmail SMTP settings (do not change these for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# The email address that receives contact messages
RECIPIENT_EMAIL=soundarfrancis@gmail.com

# Comma-separated list of allowed frontend origins (leave blank to allow all during dev)
# Example: https://fiverupeesdreams.com,https://www.fiverupeesdreams.com
ALLOWED_ORIGINS=
